---
// Redirige a la versión del sitio según el idioma del navegador.
// Los `/es/` y `/en/` los genera Astro (i18n). El español es el predeterminado.
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>David Pérez Velasco — Ingeniería de software, datos y producto</title>
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem("lang"); } catch (e) {}
        var n = (navigator.language || "es").toLowerCase();
        var loc = (stored === "en" || (stored !== "es" && n.indexOf("en") === 0)) ? "/en/" : "/es/";
        window.location.replace(loc);
      })();
    </script>
  </head>
  <body><p><a href="/es/">Portfolio de David Pérez Velasco · Español</a> / <a href="/en/">English</a></p></body>
</html>
