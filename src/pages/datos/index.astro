---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/ui";
const locale = "es";
const t = useTranslations(locale);
const fichas = (await getCollection("datos")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={t.datos.title} description={t.datos.intro}>
  <section class="mx-auto max-w-[88rem] px-5 py-12 sm:px-8 sm:py-16">
    <header class="max-w-3xl">
      <h1 class="editorial-title">{t.datos.title}<span class="text-primary">.</span></h1>
      <p class="mt-6 text-xl leading-snug text-muted">{t.datos.intro}</p>
      <p class="mt-4 text-sm text-muted">{t.datos.estructura}</p>
      <p class="mt-2 text-sm text-muted">{t.datos.preparacion}</p>
    </header>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {fichas.map((ficha) => (
        <a href={`/datos/${ficha.id.split("/")[0]}/`} class="block border border-foreground bg-surface p-6 transition-transform hover:-translate-y-1">
          <p class="font-mono text-[11px] font-bold uppercase tracking-wide text-muted">{t.datos.estado[ficha.data.status]}</p>
          <h2 class="mt-3 text-2xl font-black tracking-[-.03em]">{ficha.data.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{ficha.data.description}</p>
          <span class="mt-5 inline-block font-mono text-[11px] font-bold uppercase tracking-wide text-primary">{t.datos.abrir} →</span>
        </a>
      ))}
    </div>

    <p class="mt-12"><a href="/analisis/" class="button-secondary">{t.datos.analisis} →</a></p>
  </section>
</BaseLayout>
