---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import ProjectFilters from "../../../components/ProjectFilters.astro";
import EnMarcha from "../../../components/EnMarcha.astro";
import { useTranslations } from "../../../i18n/ui";
export function getStaticPaths() { return [{ params: { locale: "en" } }]; }
const locale = Astro.currentLocale ?? "es";
const t = useTranslations(locale);
const projects = (await getCollection("projects", ({ data }) => data.type === "project" && (data.lang ?? "es") === locale))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={t.projectsPage.title} description={t.projectsPage.intro}>
  <section class="mx-auto max-w-[88rem] px-5 py-8 sm:px-8 sm:py-16">
    <header class="grid gap-4 border-b border-foreground pb-2 md:grid-cols-[1fr_minmax(18rem,36rem)] md:items-end">
      <div><p class="kicker text-primary">{t.projectsPage.kicker} / {String(projects.length).padStart(2, "0")}</p><h1 class="editorial-title mt-3">{t.projectsPage.title}</h1></div>
      <p class="text-xl text-muted">{t.projectsPage.intro}</p>
    </header>
    <ProjectFilters />
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project.data} slug={project.id.split("/")[0]} index={index} />)}</div>

    <EnMarcha locale={locale} />

    <p class="mt-12 text-sm text-muted">
      <a href="/analisis/" class="underline underline-offset-4 hover:text-primary">{t.analysis.title} →</a>
      <span class="mx-2">·</span>
      <a href="/formacion/" class="underline underline-offset-4 hover:text-primary">{t.formacion.title} →</a>
      <span class="mx-2">·</span>
      <a href="/datos/" class="underline underline-offset-4 hover:text-primary">{t.datos.title} →</a>
    </p>

  </section>
</BaseLayout>
