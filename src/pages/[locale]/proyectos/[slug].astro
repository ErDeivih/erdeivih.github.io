---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Tabs from "../../../components/Tabs.astro";
import { locales, useTranslations, type Locale } from "../../../i18n/ui";

export async function getStaticPaths() {
  const all = await getCollection("projects");
  return locales.flatMap(locale => all
    .filter(entry => entry.data.type === "project" && (entry.data.lang ?? "es") === locale)
    .map(entry => ({ params: { locale, slug: entry.id.split("/")[0] } })));
}
const locale = (Astro.currentLocale ?? "es") as Locale;
const slug = Astro.params.slug!;
const t = useTranslations(locale);
const all = await getCollection("projects");
const project = all.find(entry => entry.data.type === "project" && (entry.data.lang ?? "es") === locale && entry.id.split("/")[0] === slug);
const tabEntries = all.filter(entry => entry.data.type === "tab" && entry.data.project === slug && (entry.data.lang ?? "es") === locale).sort((a,b) => a.data.order - b.data.order);
let panels: { id: string; label: string; Content: any }[] = [];
if (project) {
  const { Content } = await render(project);
  panels.push({ id: "resumen", label: t.project.resumen, Content });
  for (const tab of tabEntries) {
    const { Content } = await render(tab);
    panels.push({ id: tab.data.tab!, label: tab.data.label!, Content });
  }
}
---

<BaseLayout title={project?.data.title} description={project?.data.description} image={project ? project.data.image ?? null : null}>
  {project ? (
    <>
      <section style={`--project-accent:${project.data.color ?? "#3655f5"}`}>
        <div class="mx-auto max-w-[88rem] px-5 pb-12 pt-8 sm:px-8 sm:pb-20 sm:pt-12">
          <a href={`/${locale}/proyectos/`} class="kicker underline-offset-4 hover:underline">{t.project.back}</a>
          <div class="mt-10 grid gap-10 lg:grid-cols-[1.1fr_.9fr] lg:items-end">
            <div>
              <div class="flex flex-wrap gap-4"><span class="kicker text-primary">{project.data.year}</span><span class="kicker text-muted">{project.data.role}</span></div>
              <h1 class="editorial-title mt-5">{project.data.title}</h1>
              {project.data.tagline && <p class="mt-7 max-w-2xl text-2xl leading-snug text-muted">{project.data.tagline}</p>}
            </div>
            <div>
              <div class="project-visual" style={`--project-accent:${project.data.color ?? "#3655f5"}`}>
                {project.data.image ? <img src={project.data.image} alt={project.data.imageAlt ?? ""} width="1329" height="568" /> : <span class="project-monogram" aria-hidden="true">{project.data.title?.slice(0,2).toUpperCase()}</span>}
              </div>
            </div>
          </div>
          <div class="mt-10 flex flex-wrap items-center justify-between gap-6 border-y border-foreground py-5">
            <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[11px] font-bold uppercase tracking-wide text-muted">{project.data.stack?.map(item => <li>{item}</li>)}</ul>
            <div class="flex flex-wrap gap-3">
              {project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener" class="button-primary">{t.project.demo}</a>}
              {project.data.repo && <a href={project.data.repo} target="_blank" rel="noopener" class="button-secondary">{t.project.viewRepo}</a>}
            </div>
          </div>
        </div>
      </section>
      <section class="mx-auto max-w-[88rem] px-5 sm:px-8">
        <Tabs tabs={panels.map(({id,label}) => ({id,label}))} ariaLabel={t.project.sectionsLabel}>
          {panels.map(({id,Content}, index) => (
            <div role="tabpanel" data-panel={id} hidden={index > 0} class="grid gap-10 py-10 lg:grid-cols-[minmax(0,47rem)_1fr] lg:py-16">
              <article class="prose-content"><Content /></article>
              {index === 0 && project.data.highlight && <aside class="h-fit border-t-8 border-primary bg-surface p-6"><p class="kicker text-muted">{t.project.keyPoint}</p><p class="mt-3 text-xl font-bold leading-snug">{project.data.highlight}</p></aside>}
            </div>
          ))}
        </Tabs>
      </section>
    </>
  ) : (
    <section class="mx-auto max-w-[88rem] px-5 py-24 sm:px-8"><h1 class="section-title">404</h1><p class="mt-5 text-muted">{t.project.notFound}</p></section>
  )}
</BaseLayout>
