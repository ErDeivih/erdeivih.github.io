---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../../i18n/ui";
export function getStaticPaths() { return [{ params: { locale: "en" } }]; }
const locale = Astro.currentLocale ?? "en";
const t = useTranslations(locale);
const fichas = (await getCollection("datos")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={t.datos.title} description={t.datos.intro}>
  <section class="mx-auto max-w-[88rem] px-5 py-12 sm:px-8 sm:py-16">
    <header class="max-w-3xl">
      <h1 class="editorial-title">{t.datos.title}<span class="text-primary">.</span></h1>
      <p class="mt-6 text-xl leading-snug text-muted">{t.datos.intro}</p>
      <p class="mt-4 text-sm text-muted">{t.datos.estructura}</p>
      <p class="mt-2 text-sm text-muted">{t.datos.preparacion}</p>
      <p class="mt-2 text-sm text-muted">Sheets are written in Spanish for now.</p>
    </header>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {fichas.map((ficha) => (
        <article class="block border border-foreground bg-surface p-6">
          <p class="font-mono text-[11px] font-bold uppercase tracking-wide text-muted">{t.datos.estado[ficha.data.status]}</p>
          {ficha.data.image && <img src={ficha.data.image} alt={ficha.data.imageAlt ?? ficha.data.title} class="mt-3 w-full border border-foreground" />}
          <h2 class="mt-3 text-2xl font-black tracking-[-.03em]"><a href={`/en/datos/${ficha.id.split("/")[0]}/`} class="underline-offset-4 hover:underline">{ficha.data.title}</a></h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{ficha.data.description}</p>
          <p class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
            <a href={`/en/datos/${ficha.id.split("/")[0]}/`} class="inline-flex min-h-11 items-center font-mono text-[11px] font-bold uppercase tracking-wide text-primary">{t.datos.abrir} →</a>
            {ficha.data.casoUrl && <a href={ficha.data.casoUrl} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-sm underline underline-offset-4 hover:text-primary">{t.datos.caso} ↗</a>}
          </p>
        </article>
      ))}
    </div>
    <p class="mt-12"><a href="/en/analisis/" class="button-secondary">{t.datos.analisis} →</a></p>
  </section>
</BaseLayout>
