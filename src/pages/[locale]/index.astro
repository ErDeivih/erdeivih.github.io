---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectFilters from "../../components/ProjectFilters.astro";
import { localePath, useTranslations } from "../../i18n/ui";

export function getStaticPaths() { return [{ params: { locale: "en" } }]; }
const locale = Astro.currentLocale ?? "es";
const t = useTranslations(locale);
const projects = (await getCollection("projects", ({ data }) => data.type === "project" && (data.lang ?? "es") === locale))
  .sort((a, b) => a.data.order - b.data.order);
const destacados = projects.filter((p) => p.data.featured);
---

<BaseLayout>
  <Hero />

  <section aria-labelledby="projects-title" class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 sm:py-28">
    <header class="reveal grid gap-8 border-b border-foreground pb-8 md:grid-cols-[1fr_minmax(18rem,34rem)] md:items-end">
      <div>
        <p class="kicker text-primary">{t.projectsHome.kicker}</p>
        <h2 id="projects-title" class="section-title mt-4">{t.projectsHome.title}</h2>
      </div>
      <p class="text-lg text-muted">{t.projectsHome.intro}</p>
    </header>
    <ProjectFilters />
    <div class="project-grid">
      {destacados.map((project, index) => <ProjectCard project={project.data} slug={project.id.split("/")[0]} index={index} />)}
    </div>
    <a href={localePath(locale, "/proyectos/")} class="button-secondary mt-10">{t.projectsHome.all} →</a>
  </section>


  <section class="mx-auto max-w-[88rem] px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-6 border-y border-foreground py-10 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 class="section-title">{t.analysis.title}</h2>
        <p class="mt-4 max-w-2xl text-lg text-muted">{t.analysis.intro}</p>
      </div>
      <a href={localePath(locale, "/analisis/")} class="button-primary">{t.analysis.link} <span class="ml-2" aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="sobre-mi" class="border-y border-foreground bg-surface">
    <div class="mx-auto grid max-w-[88rem] gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[.8fr_1.2fr]">
      <div class="reveal">
        <p class="kicker text-secondary">{t.about.kicker}</p>
        <h2 class="section-title mt-4">{t.about.title}</h2>
      </div>
      <div class="reveal">
        <p class="max-w-3xl text-2xl font-semibold leading-snug tracking-[-.025em] sm:text-3xl">{t.about.lead}</p>
        <p class="mt-6 max-w-2xl text-lg text-muted">{t.about.text}</p>
        <dl class="mt-8 grid gap-4 border-t border-foreground pt-6 sm:grid-cols-2">
          {t.about.rows.map((row) => (
            <div>
              <dt class="text-sm font-bold">{row.label}</dt>
              <dd class="text-sm text-muted">{row.value}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          {t.about.principles.map((item, index) => (
            <div class="border-t border-foreground pt-4">
              <p class="project-number text-primary">0{index + 1}</p>
              <h3 class="mt-3 text-lg font-bold">{item.title}</h3>
              <p class="mt-2 text-sm text-muted">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
