---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import { cursos } from "../../data/formacion";
import ProjectCard from "../../components/ProjectCard.astro";
import { localePath, useTranslations } from "../../i18n/ui";

export function getStaticPaths() { return [{ params: { locale: "en" } }]; }
const locale = Astro.currentLocale ?? "es";
const t = useTranslations(locale);
const idioma = locale === "en" ? "en" : "es";
const projects = (await getCollection("projects", ({ data }) => data.type === "project" && (data.lang ?? "es") === locale))
  .sort((a, b) => a.data.order - b.data.order);
const ELEGIDOS = ["documentchain", "facylf", "compra-alimentacion"];
const destacados = ELEGIDOS.flatMap((slug) => {
  const p = projects.find((x) => x.id.split("/")[0] === slug);
  return p ? [p] : [];
});
---

<BaseLayout>
  <Hero />

  <section aria-labelledby="projects-title" class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 sm:py-28">
    <header class="reveal grid gap-8 border-b border-foreground pb-8 md:grid-cols-[1fr_minmax(18rem,34rem)] md:items-end">
      <div>
        <p class="kicker text-primary">{t.projectsHome.kicker}</p>
        <h2 id="projects-title" class="section-title mt-4">{t.projectsHome.title}</h2>
      </div>
      <p class="text-lg text-muted">{t.projectsHome.intro}</p>
    </header>
    <div class="project-grid">
      {destacados.map((project, index) => <ProjectCard project={project.data} slug={project.id.split("/")[0]} index={index} />)}
    </div>
    <a href={localePath(locale, "/proyectos/")} class="button-secondary mt-10">{t.projectsHome.all} →</a>
    <a href={localePath(locale, "/proyectos/#en-marcha")} class="button-secondary mt-10 ml-3">{t.projectsHome.enMarcha} →</a>
  </section>


  <section id="experiencia" class="mx-auto max-w-[88rem] px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-6 border-y border-foreground py-10 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="kicker text-primary">{t.experience.kicker}</p>
        <h2 class="section-title mt-4">{t.experience.title}</h2>
        <p class="mt-4 max-w-2xl text-lg font-semibold">{t.experience.lead}</p>
        <p class="mt-2 max-w-2xl text-lg text-muted">{t.experience.text}</p>
      </div>
      <a href="/David-Perez-Velasco-CV.pdf" class="button-primary">{t.experience.cv} <span class="ml-2" aria-hidden="true">→</span></a>
    </div>
  </section>


  <section id="formacion" class="mx-auto max-w-[88rem] px-5 py-16 sm:px-8 sm:py-20">
    <div class="border-y border-foreground py-10">
      <p class="kicker text-primary">{t.formacion.kicker}</p>
      <h2 class="section-title mt-4">{t.formacion.title}<span class="text-primary">.</span></h2>
      <p class="mt-4 max-w-2xl text-lg text-muted">{t.formacion.cursosIntro}</p>
      <ul class="mt-6 grid gap-2 sm:grid-cols-2">
        {cursos.map((curso) => (
          <li class="flex items-baseline justify-between gap-3 border-t border-foreground pt-2">
            <span><span class="font-bold">{curso.nombre[idioma]}</span><span class="block text-sm text-muted">{curso.entidad}</span></span>
            <span class="text-right text-sm text-muted">{curso.coste[idioma]}</span>
          </li>
        ))}
      </ul>
      <a href={localePath(locale, "/formacion/")} class="button-secondary mt-6">{t.formacion.title} →</a>
    </div>
  </section>

  <section id="sobre-mi" class="border-y border-foreground bg-surface">
    <div class="mx-auto grid max-w-[88rem] gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[.8fr_1.2fr]">
      <div class="reveal">
        <p class="kicker text-secondary">{t.about.kicker}</p>
        <h2 class="section-title mt-4">{t.about.title}</h2>
      </div>
      <div class="reveal">
        <p class="max-w-3xl text-2xl font-semibold leading-snug tracking-[-.025em] sm:text-3xl">{t.about.lead}</p>
        <p class="mt-6 max-w-2xl text-lg text-muted">{t.about.text}</p>
        <dl class="mt-8 grid gap-4 border-t border-foreground pt-6 sm:grid-cols-2">
          {t.about.rows.map((row) => (
            <div>
              <dt class="text-sm font-bold">{row.label}</dt>
              <dd class="text-sm text-muted">{row.value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-8"><a href="/David-Perez-Velasco-CV.pdf" class="button-secondary">{t.about.cv}</a></p>
        <p class="mt-4"><a href={localePath(locale, "/formacion/")} class="inline-flex min-h-11 items-center font-mono text-[11px] font-bold uppercase tracking-wide underline underline-offset-4 hover:text-primary">{t.formacion.title} →</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
