---
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "../i18n/ui";

interface Props {
  project: CollectionEntry<"projects">["data"];
  slug: string;
  index?: number;
}
const { project, slug, index = 0 } = Astro.props;
const locale = Astro.currentLocale ?? "es";
const t = useTranslations(locale);
const statusLabel = t.project.statuses[project.status as keyof typeof t.project.statuses] ?? project.status;
const monogram = project.title?.split(/\s+/).map(word => word[0]).join("").slice(0, 2) ?? "DP";
---

<article class="project-card reveal py-8 sm:py-10">
  <div class="grid gap-6 lg:grid-cols-[minmax(18rem,.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12">
    <a href={`/${locale}/proyectos/${slug}/`} class="project-visual block" style={`--project-accent:${project.color ?? "#3655f5"}`} aria-label={`${t.project.card.view}: ${project.title}`}>
      {project.image ? (
        <img src={project.image} alt={project.imageAlt ?? ""} width="1329" height="568" loading={index > 0 ? "lazy" : "eager"} />
      ) : (
        <>
          <span class="absolute left-4 top-4 rounded-full bg-background px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider">{project.highlight ?? project.stack?.[0]}</span>
          <span class="project-monogram" aria-hidden="true">{monogram}</span>
        </>
      )}
    </a>

    <div>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="project-number">{String(index + 1).padStart(2, "0")} / {project.year ?? "2026"}</p>
        <p class="kicker text-muted">{statusLabel}</p>
      </div>
      <h2 class="mt-5 text-4xl font-black tracking-[-.055em] sm:text-6xl">{project.title}</h2>
      {project.tagline && <p class="mt-4 max-w-xl text-xl leading-snug text-muted">{project.tagline}</p>}
      {project.highlight && <p class="mt-5 border-l-4 pl-4 font-mono text-sm" style={`border-color:${project.color ?? "#f0522d"}`}>{project.highlight}</p>}
      <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[11px] font-bold uppercase tracking-wide text-muted">
        {project.stack?.slice(0, 5).map(item => <li>{item}</li>)}
      </ul>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={`/${locale}/proyectos/${slug}/`} class="button-primary">{t.project.card.view}</a>
        {project.demo && <a href={project.demo} target="_blank" rel="noopener" class="button-secondary">{t.project.demo}</a>}
      </div>
    </div>
  </div>
</article>
