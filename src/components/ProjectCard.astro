---
import type { CollectionEntry } from "astro:content";
import { localePath, useTranslations } from "../i18n/ui";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: CollectionEntry<"projects">["data"];
  slug: string;
  index?: number;
}
const { project, slug, index = 0 } = Astro.props;
const locale = Astro.currentLocale ?? "es";
const t = useTranslations(locale);
const statusLabel = t.project.statuses[project.status as keyof typeof t.project.statuses] ?? project.status;
---

<article data-project-status={project.status} class:list={["project-card reveal py-8 sm:py-10", project.status === "planned" && "project-card-planned"]} style={`--delay:${Math.min(index, 6) * 60}ms`}>
  <div class="grid gap-6 lg:grid-cols-[minmax(18rem,.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12">
    <a href={localePath(locale, `/proyectos/${slug}/`)} class="project-visual block" style={`--project-accent:${project.color ?? "#3655f5"}`} aria-label={`${t.project.card.view}: ${project.title}`}>
      <ProjectVisual slug={slug} title={project.title} image={project.captures?.[0]?.src ?? project.image} imageAlt={project.captures?.[0]?.alt ?? project.imageAlt} eager={index === 0} />
    </a>

    <div>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="project-number">{String(index + 1).padStart(2, "0")} / {project.year ?? "2026"}</p>
        <p class="kicker status-badge text-muted">{statusLabel}</p>
      </div>
      {project.status === "planned" && <p class="mt-4 inline-flex border border-foreground bg-panel px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider">{t.project.plannedNote}</p>}
      <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
        <h2 class="text-4xl font-black tracking-[-.055em] sm:text-6xl">{project.title}</h2>
        <ul class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px] font-bold uppercase tracking-wide text-muted">
          {project.stack?.slice(0, 4).map(item => <li>{item}</li>)}
        </ul>
      </div>
      {project.tagline && <p class="mt-3 max-w-xl text-base leading-snug text-muted">{project.tagline}</p>}
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={localePath(locale, `/proyectos/${slug}/`)} class="button-primary min-h-11 px-4">{t.project.card.view} →</a>
        {project.demo && <a href={project.demo} target="_blank" rel="noopener" class="button-secondary">{t.project.demo}</a>}
      </div>
    </div>
  </div>
</article>
