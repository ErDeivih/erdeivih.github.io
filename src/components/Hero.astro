---
import { social } from "../config/site";
import { localePath, useTranslations } from "../i18n/ui";

const locale = Astro.currentLocale ?? "es";
const { hero } = useTranslations(locale);
---

<section id="inicio" class="border-b border-foreground">
  <div class="mx-auto max-w-[88rem] px-5 pb-16 pt-14 sm:px-8 sm:pb-24 sm:pt-20">
    <h1 class="editorial-title reveal mt-4 max-w-[13ch] sm:mt-8" style="transition-delay:.05s">
      {hero.headline}<span class="text-primary">.</span>
    </h1>
    <p class="reveal mt-3 font-mono text-xs font-bold tracking-wide text-muted" style="transition-delay:.07s">{hero.stackLine}</p>
    <div class="mt-10 grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(18rem,30rem)] md:items-end">
      <div>
        <p class="reveal max-w-2xl text-xl leading-snug text-muted sm:text-2xl" style="transition-delay:.1s">{hero.intro}</p>
        <div id="prueba" class="reveal mt-5 max-w-2xl border-l-4 border-primary pl-4" style="transition-delay:.12s">
          <p class="text-sm font-bold text-muted">{hero.featuredLabel}</p>
          <p class="mt-1 text-xl font-black tracking-[-.02em]">{hero.featuredName}</p>
          <p class="mt-1 font-mono text-[11px] font-bold uppercase tracking-wide text-muted">{hero.featuredStack}</p>
          <p class="mt-2 text-base font-semibold">{hero.proof}</p>
          <p class="mt-2"><a href={localePath(locale, "/proyectos/compra-alimentacion/")} class="inline-flex min-h-11 items-center font-bold underline underline-offset-4 hover:text-primary">{hero.featuredCta}</a></p>
        </div>
      </div>
      <div class="reveal grid grid-cols-2 gap-2 md:flex md:flex-wrap md:justify-end" style="transition-delay:.15s">
        <a href={localePath(locale, "/proyectos/")} class="button-primary w-full justify-center md:w-auto">{hero.viewProjects} <span class="ml-2" aria-hidden="true">↘</span></a>
        <a href="/David-Perez-Velasco-CV.pdf" class="button-secondary w-full justify-center md:w-auto">{hero.downloadCv}</a>
        <a href={social.github} target="_blank" rel="noopener" class="col-span-2 inline-flex min-h-11 items-center justify-center text-sm underline underline-offset-4 hover:text-primary md:col-span-1">GitHub ↗</a>
      </div>
    </div>
    <div class="reveal mt-16 grid border-y border-foreground sm:grid-cols-2" style="transition-delay:.2s">
      {hero.facts.map((fact, i) => (
        <div class:list={["py-4 sm:px-5", i > 0 && "border-t border-foreground sm:border-l sm:border-t-0"]}>
          <p class="text-sm font-bold text-muted">{fact.label}</p>
          <p class="mt-1 text-lg font-bold">{fact.value}</p>
        </div>
      ))}
    </div>
  </div>
</section>
