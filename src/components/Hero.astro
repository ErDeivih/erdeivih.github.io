---
import { social } from "../config/site";
import { useTranslations } from "../i18n/ui";

const locale = Astro.currentLocale ?? "es";
const { hero } = useTranslations(locale);
---

<section id="inicio" class="border-b border-foreground">
  <div class="mx-auto max-w-[88rem] px-5 pb-16 pt-14 sm:px-8 sm:pb-24 sm:pt-20">
    <div class="reveal flex flex-wrap items-center justify-between gap-4 border-b border-foreground pb-4">
      <p class="kicker">{hero.eyebrow}</p>
      <p class="kicker text-muted">{hero.availability}</p>
    </div>
    <h1 class="editorial-title reveal mt-8 max-w-[13ch]" style="transition-delay:.05s">
      {hero.headline}<span class="text-primary">.</span>
    </h1>
    <div class="mt-10 grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(18rem,30rem)] md:items-end">
      <p class="reveal max-w-2xl text-xl leading-snug text-muted sm:text-2xl" style="transition-delay:.1s">{hero.intro}</p>
      <div class="reveal flex flex-wrap gap-3 md:justify-end" style="transition-delay:.15s">
        <a href={`/${locale}/proyectos/`} class="button-primary">{hero.viewProjects} <span aria-hidden="true">↘</span></a>
        <a href={social.github} target="_blank" rel="noopener" class="button-secondary">GitHub ↗</a>
      </div>
    </div>
    <div class="reveal mt-16 grid border-y border-foreground sm:grid-cols-3" style="transition-delay:.2s">
      {hero.facts.map((fact, i) => (
        <div class:list={["py-4 sm:px-5", i > 0 && "border-t border-foreground sm:border-l sm:border-t-0"]}>
          <p class="kicker text-muted">{fact.label}</p>
          <p class="mt-1 text-lg font-bold">{fact.value}</p>
        </div>
      ))}
    </div>
  </div>
</section>
