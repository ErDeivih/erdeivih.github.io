---
import { enMarcha } from "../data/enMarcha";
import { localePath, useTranslations } from "../i18n/ui";
interface Props { locale: string }
const { locale } = Astro.props;
const t = useTranslations(locale);
const idioma = locale === "en" ? "en" : "es";
---
<section class="mt-16 border-t border-foreground pt-8" aria-labelledby="en-marcha">
  <h2 id="en-marcha" class="section-title">{t.marcha.title}<span class="text-primary">.</span></h2>
  <p class="mt-4 max-w-2xl text-lg text-muted">{t.marcha.intro}</p>
  <ul class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2">
    {enMarcha.map((p) => (
      <li class="border-t border-foreground pt-4">
        <div class="flex items-baseline justify-between gap-3">
          <a href={p.href} class="inline-flex min-h-11 items-center text-xl font-black tracking-[-.03em] hover:text-primary">{p.nombre[idioma]}</a>
          <span class="shrink-0 font-mono text-[10px] font-bold uppercase tracking-wide text-muted">{p.estado[idioma]}</span>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted">{p.linea[idioma]}</p>
      </li>
    ))}
  </ul>
</section>
