---
import { site, nav } from "../config/site";
const { pathname } = Astro.url;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/" || pathname === "/index";
  return pathname.startsWith(href.split("#")[0]);
};
---

<header class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2 text-sm font-bold tracking-wide uppercase"
    >
      <span class="font-display text-[11px] text-primary glow">{site.brand}</span>
      <span class="cursor-blink text-primary">▮</span>
    </a>

    <!-- Enlaces (escritorio) -->
    <ul class="hidden items-center gap-1 sm:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "px-3 py-2 text-xs font-bold tracking-wide uppercase transition-colors",
                isActive(item.href) ? "text-primary" : "text-muted hover:text-foreground",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Botón menú (móvil) -->
    <button
      type="button"
      id="menu-toggle"
      class="flex h-10 w-10 items-center justify-center rounded border border-border text-foreground sm:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </nav>

  <!-- Drawer móvil -->
  <div id="mobile-menu" class="hidden border-t border-border bg-background sm:hidden">
    <ul class="flex flex-col gap-1 px-4 py-3">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "block rounded px-3 py-3 text-sm font-bold tracking-wide uppercase transition-colors",
                isActive(item.href) ? "bg-surface text-primary" : "text-muted hover:bg-surface hover:text-foreground",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    });
    // Cierra al pulsar un enlace
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).matches("a")) {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>
