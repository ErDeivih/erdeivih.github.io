---
interface Props { tabs: { id: string; label: string }[]; ariaLabel?: string }
const { tabs, ariaLabel = "Project sections" } = Astro.props;
---

<div data-tabs>
  <div role="tablist" aria-label={ariaLabel} class="flex gap-1 overflow-x-auto border-b border-foreground pb-px">
    {tabs.map((tab, i) => (
      <button type="button" role="tab" data-value={tab.id} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}
        class="whitespace-nowrap border-b-4 border-transparent px-4 py-3 font-mono text-[11px] font-bold uppercase tracking-wider text-muted hover:text-foreground aria-selected:border-primary aria-selected:text-foreground">
        {String(i + 1).padStart(2, "0")} {tab.label}
      </button>
    ))}
  </div>
  <slot />
</div>

<script>
  function setupTabs() {
    document.querySelectorAll<HTMLElement>("[data-tabs]").forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";
      const triggers = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
      const activate = (id: string) => {
        triggers.forEach(trigger => {
          const active = trigger.dataset.value === id;
          trigger.setAttribute("aria-selected", String(active));
          trigger.tabIndex = active ? 0 : -1;
        });
        panels.forEach(panel => panel.hidden = panel.dataset.panel !== id);
      };
      triggers.forEach((trigger, i) => {
        trigger.addEventListener("click", () => activate(trigger.dataset.value!));
        trigger.addEventListener("keydown", event => {
          let next: number | null = null;
          if (event.key === "ArrowRight") next = (i + 1) % triggers.length;
          if (event.key === "ArrowLeft") next = (i - 1 + triggers.length) % triggers.length;
          if (event.key === "Home") next = 0;
          if (event.key === "End") next = triggers.length - 1;
          if (next !== null) { event.preventDefault(); activate(triggers[next].dataset.value!); triggers[next].focus(); }
        });
      });
      if (triggers[0]) activate(triggers[0].dataset.value!);
    });
  }
  setupTabs();
  document.addEventListener("astro:page-load", setupTabs);
</script>
